  "cues": [
   [
    0.117,
    "Here's a line with slope m, through a known point, x one, y one."
   ],
   [
    5.352,
    "Now take any other point on the line, x, y."
   ],
   [
    8.737,
    "From the known point, the rise is y minus y one."
   ],
   [
    12.786,
    "The run is x minus x one."
   ],
   [
    15.469,
    "Rise over run is the slope, so y minus y one, over x minus x one, equals m."
   ],
   [
    22.708,
    "Multiply both sides by x minus x one, and you get point slope form: y minus y one equals m times x minus x one."
   ]
  ]
