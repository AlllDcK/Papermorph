  "cues": [
   [
    0.091,
    "Look again at the quadratic formula."
   ],
   [
    2.5,
    "The part under the radical, b squared minus four a c, is called the discriminant."
   ],
   [
    7.995,
    "The plus or minus adds and subtracts its square root."
   ],
   [
    12.331,
    "If the discriminant is positive, its square root is a positive number, and the plus and minus give two different solutions."
   ],
   [
    20.742,
    "If it's zero, plus zero and minus zero are the same, so there's one solution."
   ],
   [
    26.51,
    "If it's negative, its square root isn't a real number: no real solutions."
   ]
  ]
