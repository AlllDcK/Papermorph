  "cues": [
   [
    0.104,
    "The area of a rectangle is length times width: A equals l w."
   ],
   [
    5.43,
    "A rectangle with area twenty-four square centimeters is six centimeters long."
   ],
   [
    10.859,
    "How wide is it?"
   ],
   [
    12.148,
    "Treat w as the unknown."
   ],
   [
    14.401,
    "l multiplies w, so divide both sides by l."
   ],
   [
    18.789,
    "w equals A over l."
   ],
   [
    21.146,
    "Now plug in: twenty-four over six is four centimeters."
   ],
   [
    25.456,
    "Rewriting once gives a formula you can reuse for any rectangle."
   ]
  ]
 },
