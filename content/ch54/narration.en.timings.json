    0.117,
    "Build x squared plus five x plus six with algebra tiles: one x squared, five x strips, and six unit squares."
   ],
   [
    9.05,
    "Factoring means arranging all of them into one rectangle."
   ],
   [
    13.529,
    "Put the big square in the corner, the x strips along two sides, and the ones fill the corner that's left."
   ],
   [
    20.482,
    "The rectangle is x plus two tall and x plus three wide."
   ],
   [
    24.961,
    "So x squared plus five x plus six equals x plus two, times x plus three."
   ]
  ]
