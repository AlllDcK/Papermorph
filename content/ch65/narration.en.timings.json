  "cues": [
   [
    0.104,
    "To use it, first write the equation as a x squared plus b x plus c equals zero."
   ],
   [
    6.888,
    "Take two x squared minus seven x plus three equals zero."
   ],
   [
    12.292,
    "Read off a, b, and c: two, negative seven, and three."
   ],
   [
    18.359,
    "Put them into the formula."
   ],
   [
    19.948,
    "Be careful with the signs: negative b is negative negative seven, which is seven."
   ],
   [
    26.003,
    "Under the radical, forty-nine minus twenty-four is twenty-five."
   ],
   [
    30.234,
    "The square root of twenty-five is five."
   ],
   [
    33.099,
    "So x is seven plus five over four, or seven minus five over four."
   ],
   [
    39.141,
    "That's three, or one half."
   ]
  ]
