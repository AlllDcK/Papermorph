  "cues": [
   [
    0.104,
    "Where does it come from?"
   ],
   [
    1.341,
    "Complete the square on a x squared plus b x plus c equals zero, using letters instead of numbers."
   ],
   [
    9.727,
    "Divide by a, and move c over."
   ],
   [
    12.422,
    "Add the square of b over two a to both sides."
   ],
   [
    16.549,
    "The left side becomes x plus b over two a, squared."
   ],
   [
    20.846,
    "The right side becomes b squared minus four a c, over four a squared."
   ],
   [
    26.12,
    "Take square roots of both sides, then subtract b over two a."
   ],
   [
    30.82,
    "That's the quadratic formula: x equals negative b, plus or minus the square root of b squared minus four a c, all over two a."
   ]
  ]
 },
