  "cues": [
   [
    0.117,
    "Here's the key idea."
   ],
   [
    1.654,
    "If a product of two numbers is zero, then at least one of the numbers must be zero."
   ],
   [
    7.214,
    "This is the zero-product principle."
   ],
   [
    9.492,
    "Any two nonzero numbers multiply to something nonzero, so a zero product needs a zero factor."
   ],
   [
    16.914,
    "So if x minus two, times y minus five, equals zero, then x minus two is zero, or y minus five is zero: x is two, or y is five."
   ]
  ]
 },
