  "cues": [
   [
    0.104,
    "What if you only know two points?"
   ],
   [
    2.005,
    "Say, three, two and negative five, six."
   ],
   [
    5.729,
    "First find the slope: six minus two is four, and negative five minus three is negative eight."
   ],
   [
    12.526,
    "The slope is negative one half."
   ],
   [
    14.766,
    "Next, put one point into y equals m x plus b."
   ],
   [
    19.01,
    "Use three, two: two equals negative one half times three, plus b."
   ],
   [
    25.052,
    "That's two equals negative three halves plus b, so b is seven halves."
   ],
   [
    30.794,
    "The equation is y equals negative one half x plus seven halves."
   ],
   [
    36.576,
    "The line crosses the y axis at three and a half, just as the equation says."
   ]
  ]
 },
