  "cues": [
   [
    0.091,
    "Solve x squared equals nine."
   ],
   [
    3.151,
    "Which numbers squared give nine?"
   ],
   [
    5.456,
    "Three, and also negative three."
   ],
   [
    7.917,
    "On a graph, the parabola y equals x squared meets the line y equals nine at two points: x equals three and x equals negative three."
   ],
   [
    18.034,
    "So the solution is x equals plus or minus three."
   ],
   [
    22.148,
    "This is the square root property: if x squared equals b, then x equals plus or minus the square root of b."
   ],
   [
    30.755,
    "The radical sign alone gives only the positive root, so the plus or minus has to be written in."
   ]
  ]
