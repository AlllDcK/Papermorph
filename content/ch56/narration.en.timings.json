    0.104,
    "The first pattern is a difference of two squares: a squared minus b squared."
   ],
   [
    5.0,
    "Start with a big square, a by a."
   ],
   [
    8.216,
    "Cut a small b by b square out of its corner."
   ],
   [
    11.172,
    "The area left is a squared minus b squared."
   ],
   [
    14.44,
    "Slice the leftover shape into two rectangles, and swing one of them around to the side."
   ],
   [
    20.208,
    "Now it's one rectangle: a plus b long, and a minus b wide."
   ],
   [
    25.221,
    "So a squared minus b squared equals a plus b, times a minus b."
   ]
  ]
