    0.104,
    "Here's a quick test for a proportion."
   ],
   [
    2.201,
    "Is two thirds equal to eight twelfths?"
   ],
   [
    4.948,
    "Multiply diagonally: two times twelve is twenty-four."
   ],
   [
    9.206,
    "And three times eight is also twenty-four."
   ],
   [
    12.461,
    "The cross products are equal, so the ratios form a proportion."
   ],
   [
    16.732,
    "What about three quarters and four eighths?"
   ],
   [
    19.323,
    "Three times eight is twenty-four, but four times four is sixteen."
   ],
   [
    24.128,
    "The cross products are different, so they're not a proportion."
   ]
  ]
