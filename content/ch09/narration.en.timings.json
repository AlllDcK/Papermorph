  "cues": [
   [
    0.091,
    "Let's add one point two and seventy-three point six five."
   ],
   [
    4.401,
    "If you line up the last digits, you'd be adding two tenths to five hundredths."
   ],
   [
    8.997,
    "That doesn't work."
   ],
   [
    10.182,
    "Each column has to hold one place value: tens, ones, tenths, hundredths."
   ],
   [
    16.536,
    "So line up the decimal points instead."
   ],
   [
    18.906,
    "You can write a zero after the two, because one point two and one point two zero are equal."
   ],
   [
    25.326,
    "Now add each column, from right to left, zero plus five is five, two plus six is eight, one plus three is four, and seven comes down."
   ],
   [
    36.367,
    "The decimal point drops straight down."
   ],
   [
    38.932,
    "The sum is seventy-four point eight five."
   ]
  ]
